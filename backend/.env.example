# Database
DATABASE_URL="postgresql://postgres:vimal1112@localhost:5432/superlink_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=3002
NODE_ENV="development"
API_VERSION="v1"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption (for site credentials - AES-256-GCM)
ENCRYPTION_KEY="your-32-char-encryption-key-here!!"

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_URL=""

# WhatsApp Cloud API (fill after Meta approval)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_WEBHOOK_URL=""

# Frontend URL (for links in emails/notifications)
FRONTEND_URL="http://localhost:5173"