# Root gitignore for SuperLink PERN Stack CRM

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
dist/
build/
*.local
backend/dist/
frontend/dist/

# Environment files
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Database
*.sqlite
*.db

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE temp files
*.tmp
*.temp
.*.swp

# Prisma
backend/prisma/migrations/

# Test coverage
coverage/
.nyc_output/

# Misc
*.pem
.cache/
.temp/
tmp/